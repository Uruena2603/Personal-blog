---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Proof from "../components/Proof.astro";
import ClientWork from "../components/ClientWork.astro";
import CaseStudy from "../components/CaseStudy.astro";
import Engineering from "../components/Engineering.astro";
import Stack from "../components/Stack.astro";
import HowIWork from "../components/HowIWork.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

const title =
  "Juan Alejandro Urueña Serna | Sitios, embudos y automatización";
const description =
  "Ingeniero de Sistemas y Telecomunicaciones en Pereira. Construyo sitios, captura de leads, medición y automatización. Diez proyectos en producción y un embudo con más de 250 registros.";
---

<Base title={title} description={description}>
  <Nav />
  <main id="contenido">
    <Hero />
    <Proof />
    <ClientWork />
    <CaseStudy />
    <Engineering />
    <Stack />
    <HowIWork />
    <Contact />
  </main>
  <Footer />
</Base>
