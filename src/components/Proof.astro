---
// Cifras verificadas en la sesión del 2026-08-13. Cada una es defendible
// si alguien pregunta. No poner aquí nada que no se pueda sostener.
const stats = [
  { value: "10", label: "sitios en producción" },
  { value: "250+", label: "registros captados en un solo embudo" },
  { value: "4", label: "clientes que pagaron" },
  { value: "2", label: "países" },
];
---

<section class="section section--bordered proof" aria-label="Cifras">
  <div class="container">
    <ul class="grid grid--4 proof__list">
      {
        stats.map((stat) => (
          <li class="proof__item">
            <span class="proof__value">{stat.value}</span>
            <span class="proof__label">{stat.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .proof {
    padding-block: clamp(2.5rem, 1.8rem + 3vw, 4rem);
    background: var(--bg-raised);
  }

  .proof__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .proof__item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-left: 1.1rem;
    border-left: 2px solid var(--accent-soft);
  }

  .proof__value {
    font-size: var(--step-4);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .proof__label {
    font-size: var(--step--1);
    color: var(--text-muted);
    text-wrap: balance;
  }
</style>
