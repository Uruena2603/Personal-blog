---
// La sección con más peso del sitio: es la única prueba con números.
// El fondo lleva Particles de ReactBits: CanvasUI quedó descartado porque
// todo su catálogo exige la bandera experimental html-in-canvas de Chrome
// (verificado 2026-08-29 contra su registry) y sin ella no muestra nada.
import type { Dictionary } from "../i18n/es";
import CaseParticles from "./react/CaseParticles";

interface Props {
  t: Dictionary["caseStudy"];
}

const { t } = Astro.props;
---

<section class="section section--bordered case" id="case">
  <div class="case__particles" aria-hidden="true">
    <CaseParticles client:visible />
  </div>
  <div class="container">
    <p class="eyebrow">
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"><path d="M3 17l6-6 4 4 8-8"></path><path
          d="M14 7h7v7"></path></svg
      >
      {t.eyebrow}
    </p>
    <h2 class="section-title">{t.title}</h2>
    <p class="section-lead">{t.lead}</p>

    <ol class="case__steps">
      {
        t.steps.map((step) => (
          <li class="case__step">
            <span class="case__n">{step.n}</span>
            <div>
              <h3 class="case__title">{step.title}</h3>
              <p class="case__body">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="case__results">
      <div class="case__figures">
        {
          t.results.map((result) => (
            <div class="case__result">
              <span class="case__value">{result.value}</span>
              <span class="case__label">{result.label}</span>
            </div>
          ))
        }
      </div>
      <a
        class="btn btn--ghost"
        href="https://ecmo-lp.pages.dev"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.cta}
      </a>
    </div>
  </div>
</section>

<style>
  .case {
    background: var(--bg-raised);
    overflow: hidden;
    isolation: isolate;
  }

  .case__particles {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.5;
  }

  .case__steps {
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1.75rem;
  }

  .case__step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  .case__step:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .case__n {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: var(--step--1);
    color: var(--accent);
    letter-spacing: 0.08em;
    padding-top: 0.35rem;
  }

  .case__title {
    font-size: var(--step-1);
  }

  .case__body {
    margin-top: 0.5rem;
    color: var(--text-muted);
    max-width: var(--measure);
  }

  /* Centrado en todos los anchos: cifras juntas y el botón debajo, sin
     huecos intermedios. */
  .case__results {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.75rem;
    margin-top: 3rem;
    padding: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem);
    border: 1px solid color-mix(in srgb, var(--accent) 34%, transparent);
    border-radius: var(--radius-lg);
    background: var(--accent-soft);
  }

  .case__figures {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }

  .case__result {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .case__value {
    font-size: var(--step-4);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .case__label {
    font-size: var(--step--1);
    color: var(--text-muted);
    margin-top: 0.3rem;
  }

</style>
