---
// Inventario COMPLETO de la carrera, no solo del stack de 2026.
// Va por capas de profundidad a propósito: así se muestra toda la amplitud
// sin firmar cheques que no se puedan cobrar en una entrevista técnica.
import type { Dictionary } from "../i18n/es";
import StackLoop from "./react/StackLoop";
import TechTags from "./react/TechTags";

interface Props {
  t: Dictionary["knowledge"];
}

const { t } = Astro.props;

// El primer nivel ("lo que uso hoy") se muestra como marquesina LogoLoop:
// 17 tecnologías sin ocupar pantalla. Los niveles con matices siguen en
// rejilla estática, que se deja leer.
const [today, ...restTiers] = t.tiers;
const todayItems = today.groups.flatMap((group) => group.items);
---

<section class="section section--bordered" id="skills">
  <div class="container">
    <p class="eyebrow">
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><path d="M12 2 2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"
        ></path><path d="M2 12l10 5 10-5"></path></svg
      >
      {t.eyebrow}
    </p>
    <h2 class="section-title">{t.title}</h2>
    {t.lead && <p class="section-lead">{t.lead}</p>}

    <div class="tiers">
      <section class="tier">
        <header class="tier__head">
          <h3 class="tier__label">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"
              ></path></svg
            >
            {today.label}
          </h3>
          {today.note && <p class="tier__note">{today.note}</p>}
        </header>
        <div class="tier__loop">
          <StackLoop
            client:visible
            items={todayItems}
            ariaLabel={today.label}
          />
        </div>
      </section>
      {
        restTiers.map((tier, tierIndex) => (
          <section class="tier">
            <header class="tier__head">
              <h3 class="tier__label">
                {tierIndex === 0 ? (
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M22 10 12 5 2 10l10 5 10-5z" />
                    <path d="M6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5" />
                  </svg>
                ) : (
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="10" />
                    <path d="m16 8-2.5 5.5L8 16l2.5-5.5L16 8z" />
                  </svg>
                )}
                {tier.label}
              </h3>
              {tier.note && <p class="tier__note">{tier.note}</p>}
            </header>
            <div class="tier__groups">
              {tier.groups.map((group) => (
                <div class="tier__group">
                  <h4 class="tier__group-name">{group.name}</h4>
                  <TechTags items={group.items} />
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tiers {
    margin-top: 3rem;
    display: grid;
    gap: 2.75rem;
  }

  /* Grid item: sin esto crece hasta el ancho natural de la marquesina y
     desborda la página en horizontal (verificado a 360px). */
  .tier {
    min-width: 0;
  }

  .tier__loop {
    overflow: hidden;
  }

  .tier__head {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .tier__label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--step-1);
  }

  .tier__label svg {
    color: var(--accent);
    flex-shrink: 0;
  }

  .tier__note {
    margin-top: 0.35rem;
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .tier__groups {
    margin-top: 1.5rem;
    display: grid;
    gap: 1.5rem;
  }

  .tier__loop {
    margin-top: 1.5rem;
  }

  .tier__group-name {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
  }

  /* :global porque las etiquetas las renderiza TechTags (React SSR) y el
     scoping de Astro no marca ese HTML. */
  .tier__group :global(.tags) {
    margin-top: 0.75rem;
  }

  @media (min-width: 760px) {
    .tier__groups {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem 2.5rem;
    }
  }
</style>
