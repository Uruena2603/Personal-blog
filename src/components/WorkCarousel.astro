---
// Carrusel scroll-snap nativo: swipe en móvil, flechas en escritorio, cero
// librerías. El diseño de tarjeta viene adaptado del ChromaGrid de ReactBits
// (foco por cursor incluido); aquí ya no necesita React ni GSAP, así que la
// sección completa es HTML estático.
import type { Dictionary } from "../i18n/es";

interface Props {
  t: Dictionary["clientWork"];
}

const { t } = Astro.props;

// Paleta por posición: los clientes llevan el acento fuerte; el resto,
// variaciones sobrias del mismo par violeta/cian.
const palette = [
  { border: "#22d3ee", tint: "rgba(34, 211, 238, 0.26)" },
  { border: "#a78bfa", tint: "rgba(167, 139, 250, 0.3)" },
  { border: "#22d3ee", tint: "rgba(34, 211, 238, 0.2)" },
  { border: "#a78bfa", tint: "rgba(167, 139, 250, 0.22)" },
  { border: "#8b9cf5", tint: "rgba(139, 156, 245, 0.18)" },
  { border: "#8b9cf5", tint: "rgba(139, 156, 245, 0.18)" },
  { border: "#7c8aa5", tint: "rgba(124, 138, 165, 0.16)" },
  { border: "#7c8aa5", tint: "rgba(124, 138, 165, 0.14)" },
  { border: "#7c8aa5", tint: "rgba(124, 138, 165, 0.14)" },
];
---

<div class="carousel">
  <button class="carousel__arrow carousel__arrow--prev" aria-label={t.prevLabel}>
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg
    >
  </button>

  <ul class="carousel__track" tabindex="0">
    {
      t.projects.map((project, i) => (
        <li class="carousel__slide">
          <a
            class="chroma-card"
            href={project.href}
            target="_blank"
            rel="noopener noreferrer"
            style={`--card-border:${palette[i % palette.length].border};--card-tint:${palette[i % palette.length].tint}`}
          >
            <div class="chroma-card__img">
              <img
                src={project.image}
                alt={project.name}
                width="1200"
                height="900"
                loading="lazy"
              />
            </div>
            <footer class="chroma-card__info">
              <h3>{project.name}</h3>
              <p>{project.meta}</p>
              <span>{project.linkLabel}</span>
            </footer>
          </a>
        </li>
      ))
    }
  </ul>

  <button class="carousel__arrow carousel__arrow--next" aria-label={t.nextLabel}>
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg
    >
  </button>

  <div class="carousel__dots" aria-hidden="true"></div>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".carousel").forEach((root) => {
    const track = root.querySelector<HTMLElement>(".carousel__track")!;
    const prev = root.querySelector<HTMLButtonElement>(".carousel__arrow--prev")!;
    const next = root.querySelector<HTMLButtonElement>(".carousel__arrow--next")!;
    const dotsBox = root.querySelector<HTMLElement>(".carousel__dots")!;

    // Páginas = vistas completas del carrusel; los dots siguen el scroll.
    const pages = () =>
      Math.max(1, Math.round(track.scrollWidth / track.clientWidth));
    const current = () =>
      Math.min(pages() - 1, Math.round(track.scrollLeft / track.clientWidth));

    const renderDots = () => {
      const total = pages();
      if (dotsBox.childElementCount !== total) {
        dotsBox.replaceChildren(
          ...Array.from({ length: total }, () =>
            document.createElement("span"),
          ),
        );
      }
      [...dotsBox.children].forEach((dot, i) =>
        dot.classList.toggle("is-active", i === current()),
      );
    };

    const sync = () => {
      prev.disabled = track.scrollLeft <= 4;
      next.disabled =
        track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
      renderDots();
    };

    prev.addEventListener("click", () =>
      track.scrollBy({ left: -track.clientWidth, behavior: "smooth" }),
    );
    next.addEventListener("click", () =>
      track.scrollBy({ left: track.clientWidth, behavior: "smooth" }),
    );
    track.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync, { passive: true });
    sync();

    // Foco de luz por tarjeta (herencia del ChromaGrid de ReactBits).
    track.addEventListener("pointermove", (event) => {
      const card = (event.target as HTMLElement).closest<HTMLElement>(
        ".chroma-card",
      );
      if (!card) return;
      const rect = card.getBoundingClientRect();
      card.style.setProperty("--mouse-x", `${event.clientX - rect.left}px`);
      card.style.setProperty("--mouse-y", `${event.clientY - rect.top}px`);
    });
  });
</script>

<style>
  /* Móvil: solo el track (las columnas de flechas vacías comían ancho).
     Con puntero: flecha | track | flecha. */
  .carousel {
    position: relative;
    display: block;
  }

  @media (hover: hover) and (min-width: 768px) {
    .carousel {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.5rem;
    }
  }

  /* Vistas exactas (1/2/3 tarjetas según ancho): ninguna tarjeta cortada. */
  .carousel__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: 1rem;
    margin: 0;
    padding: 0.25rem 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  @media (min-width: 640px) {
    .carousel__track {
      grid-auto-columns: calc((100% - 1rem) / 2);
    }
  }

  @media (min-width: 980px) {
    .carousel__track {
      grid-auto-columns: calc((100% - 2rem) / 3);
    }
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  .carousel__slide {
    scroll-snap-align: start;
    display: flex;
  }

  .carousel__dots {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .carousel__dots :global(span) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line-strong);
    transition: background-color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .carousel__dots :global(span.is-active) {
    background: var(--accent);
    transform: scale(1.25);
  }

  .carousel__arrow {
    display: none;
  }

  /* Flechas solo donde hay puntero; en táctil el gesto natural es deslizar
     y la tarjeta asomada ya insinúa que hay más. */
  @media (hover: hover) and (min-width: 768px) {
    .carousel__arrow {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border-radius: 50%;
      border: 1px solid var(--line-strong);
      background: var(--surface);
      color: var(--text);
      transition: border-color 0.25s var(--ease), opacity 0.25s var(--ease);
    }

    .carousel__arrow:hover:not(:disabled) {
      border-color: var(--accent);
    }

    .carousel__arrow:disabled {
      opacity: 0.35;
      cursor: default;
    }
  }

  .chroma-card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background: linear-gradient(165deg, var(--card-tint), var(--surface) 60%);
    transition: border-color 0.3s var(--ease);

    --mouse-x: 50%;
    --mouse-y: 50%;
  }

  .chroma-card:hover {
    border-color: var(--card-border);
  }

  .chroma-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at var(--mouse-x) var(--mouse-y),
      rgba(255, 255, 255, 0.18),
      transparent 70%
    );
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s ease;
    z-index: 2;
  }

  .chroma-card:hover::before {
    opacity: 1;
  }

  .chroma-card__img {
    padding: 10px;
  }

  .chroma-card__img img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top;
    border-radius: 10px;
  }

  .chroma-card__info {
    display: grid;
    row-gap: 0.3rem;
    padding: 0.35rem 1.1rem 1rem;
  }

  .chroma-card__info h3 {
    font-size: 1.05rem;
  }

  .chroma-card__info p {
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--text-muted);
  }

  .chroma-card__info span {
    font-size: 0.85rem;
    color: var(--accent-2);
  }
</style>
